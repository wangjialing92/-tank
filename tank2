# -*- coding: utf-8 -*-
"""
================================================================================
 《光·遇》主题坦克大战 —— 「光之子 vs 冥龙」 三关版
--------------------------------------------------------------------------------
 学校附加题作业 | 原创标识：WJL（地图中央金色石柱拼字）
完全使用 pygame.draw 绘制，无需任何外部图片素材，复制即可运行。

 操作方式：
   ↑↓←→ 或 WASD   移动光之子
   空格 / J        发射金色光波
   R               游戏结束 / 通关后 重新开始
   ESC             退出游戏

 关卡设计：
   第 1 关：3 只慢速追踪敌人，熟悉操作
   第 2 关：5 只快速追踪敌人，火力更猛
   第 3 关：Boss 大冥龙（随机 10~20 次打击死亡，光波有概率暴击）
            + 无限刷新的追踪螃蟹
   每过一关随机增加 1~5 条命，可重复叠加！
   所有敌人使用 BFS 寻路绕过墙追踪光之子，且每个敌人路线不同。
   复活后 1 秒无敌：此期间敌人无法锁定、光之子无法开火。
================================================================================
"""

import pygame
import random
import sys
import math
from collections import deque

# ----------------------------- 基础常量 ---------------------------------------
TILE = 30
COLS, ROWS = 20, 20
WIDTH, HEIGHT = COLS * TILE, ROWS * TILE   # 600 x 600
FPS = 60

SKY_TOP    = (135, 206, 250)
SKY_BOTTOM = (230, 245, 255)
CLOUD_GRAY = (235, 240, 245)
CLOUD_EDGE = (200, 210, 220)
STONE_DARK = (70, 60, 90)
GOLD       = (255, 215, 80)
GOLD_EDGE  = (200, 160, 30)
WHITE      = (255, 255, 255)
CAPE_COLOR = (255, 140, 90)
KRILL_BODY = (25, 20, 35)
KRILL_EYE  = (180, 40, 40)
LIGHT_WAVE = (255, 225, 100)

# ----------------------------- 字体（兼容中文） --------------------------------
def load_font(size):
    for name in ["microsoftyahei", "simhei", "notosanscjksc",
                 "wenquanyimicrohei", "pingfangsc", "simsun"]:
        path = pygame.font.match_font(name)
        if path:
            return pygame.font.Font(path, size)
    return pygame.font.Font(None, size + 4)

def has_cn_font():
    return any(pygame.font.match_font(n) for n in
               ["microsoftyahei", "simhei", "notosanscjksc",
                "wenquanyimicrohei", "pingfangsc", "simsun"])

# ----------------------------- WJL 字母点阵 ------------------------------------
LETTER_PATTERNS = {
    "W": ["10001", "10001", "10001", "10101", "10101", "11011", "10001"],
    "J": ["01110", "00100", "00100", "00100", "00100", "10100", "01100"],
    "L": ["10000", "10000", "10000", "10000", "10000", "10000", "11111"],
}

def build_map():
    """生成障碍物：中央金色 WJL + 随机云层(可破坏) + 石门(不可破坏) + 祭坛"""
    walls = []
    start_col, start_row, gap = 2, 6, 1
    for i, letter in enumerate("WJL"):
        pattern = LETTER_PATTERNS[letter]
        col_offset = start_col + i * (5 + gap)
        for r, line in enumerate(pattern):
            for c, ch in enumerate(line):
                if ch == "1":
                    walls.append((pygame.Rect((col_offset + c) * TILE,
                                              (start_row + r) * TILE,
                                              TILE, TILE), "gold"))
    protected = [pygame.Rect(2 * TILE, 16 * TILE, TILE * 3, TILE * 3),
                 pygame.Rect(8 * TILE, 17 * TILE, TILE * 3, TILE * 3)]
    random.seed(42)
    for _ in range(45):
        rect = pygame.Rect(random.randint(0, COLS - 1) * TILE,
                           random.randint(0, ROWS - 1) * TILE, TILE, TILE)
        in_letter_zone = 4 <= rect.y // TILE <= 14
        if (not any(rect.colliderect(w) for w, _ in walls)
                and not in_letter_zone
                and not any(rect.colliderect(p) for p in protected)):
            walls.append((rect, "cloud"))
    for _ in range(12):
        rect = pygame.Rect(random.randint(0, COLS - 1) * TILE,
                           random.randint(0, ROWS - 1) * TILE, TILE, TILE)
        in_letter_zone = 4 <= rect.y // TILE <= 14
        if (not any(rect.colliderect(w) for w, _ in walls)
                and not in_letter_zone
                and not any(rect.colliderect(p) for p in protected)):
            walls.append((rect, "stone"))
    base_rect = pygame.Rect(9 * TILE, 18 * TILE, TILE * 2, TILE * 2)
    return walls, base_rect

# ----------------------------- 绘制函数 ----------------------------------------
def draw_sky(screen):
    for y in range(HEIGHT):
        t = y / HEIGHT
        color = tuple(int(SKY_TOP[i] + (SKY_BOTTOM[i] - SKY_TOP[i]) * t)
                      for i in range(3))
        pygame.draw.line(screen, color, (0, y), (WIDTH, y))
    for (cx, cy, s) in [(80, 60, 1.0), (450, 90, 1.3), (250, 40, 0.8),
                        (540, 180, 0.9), (120, 200, 1.1)]:
        pygame.draw.ellipse(screen, (245, 250, 255),
                            (cx, cy, int(70 * s), int(28 * s)))
        pygame.draw.ellipse(screen, (245, 250, 255),
                            (cx + int(20 * s), cy - int(10 * s),
                             int(45 * s), int(24 * s)))

def draw_wall(screen, rect, kind):
    if kind == "cloud":
        pygame.draw.rect(screen, CLOUD_GRAY, rect, border_radius=8)
        pygame.draw.circle(screen, CLOUD_EDGE, rect.midleft, 6)
        pygame.draw.circle(screen, CLOUD_EDGE, rect.midright, 6)
        pygame.draw.circle(screen, WHITE, (rect.centerx, rect.top + 7), 7)
    elif kind == "stone":
        pygame.draw.rect(screen, STONE_DARK, rect)
        pygame.draw.rect(screen, (100, 90, 130), rect, 2)
        pygame.draw.line(screen, (100, 90, 130), rect.midtop,
                         rect.midbottom, 2)
    elif kind == "gold":
        pygame.draw.rect(screen, GOLD, rect, border_radius=4)
        pygame.draw.rect(screen, GOLD_EDGE, rect, 2, border_radius=4)
        pygame.draw.circle(screen, (255, 245, 180), rect.center, 4)

def draw_base(screen, rect, destroyed=False):
    if destroyed:
        pygame.draw.rect(screen, (60, 60, 70), rect, border_radius=6)
        pygame.draw.line(screen, (40, 40, 50), rect.topleft,
                         rect.bottomright, 3)
        return
    pygame.draw.rect(screen, (120, 110, 160), rect, border_radius=6)
    pygame.draw.rect(screen, (90, 80, 130), rect, 3, border_radius=6)
    cx, cy = rect.center
    for r, col in [(22, (255, 240, 200)), (15, (255, 210, 120)),
                   (8, (255, 180, 60))]:
        pygame.draw.circle(screen, col, (cx, cy), r, 3)
    pygame.draw.circle(screen, WHITE, (cx, cy), 4)

def draw_player(screen, x, y, direction, invincible):
    """光之子：白圆身体 + 橙色斗篷 + 光环；无敌时半透明闪烁"""
    cx, cy = int(x), int(y)
    if invincible > 0 and (invincible // 5) % 2 == 0:
        return                      # 无敌闪烁：半隐半现
    dx, dy = direction
    back_x, back_y = cx - dx * 14, cy - dy * 14
    perp_x, perp_y = -dy * 10, dx * 10
    cape = [(cx + dx * 2, cy + dy * 2),
            (back_x + perp_x, back_y + perp_y),
            (back_x - perp_x, back_y - perp_y)]
    pygame.draw.polygon(screen, CAPE_COLOR, cape)
    pygame.draw.circle(screen, (255, 250, 235), (cx, cy), 11)
    pygame.draw.circle(screen, WHITE, (cx, cy), 11, 2)
    pygame.draw.circle(screen, GOLD, (cx, cy - 14), 5, 2)
    pygame.draw.circle(screen, LIGHT_WAVE, (cx + dx * 14, cy + dy * 14), 4)

def draw_enemy(screen, x, y, kind):
    cx, cy = int(x), int(y)
    if kind == "krill":    # 普通冥龙
        pygame.draw.ellipse(screen, KRILL_BODY, (cx - 14, cy - 9, 28, 18))
        pygame.draw.polygon(screen, KRILL_BODY,
                            [(cx, cy), (cx - 18, cy - 16), (cx - 10, cy)])
        pygame.draw.polygon(screen, KRILL_BODY,
                            [(cx, cy), (cx + 18, cy - 16), (cx + 10, cy)])
        pygame.draw.circle(screen, KRILL_EYE, (cx + 8, cy - 3), 3)
        pygame.draw.circle(screen, KRILL_EYE, (cx + 8, cy + 3), 3)
    else:                  # 黑螃蟹
        pygame.draw.circle(screen, (30, 25, 40), (cx, cy), 11)
        for k in range(3):
            lx = cx - 12 + k * 12
            pygame.draw.line(screen, KRILL_BODY, (lx, cy - 8),
                             (lx - 4, cy - 16), 2)
            pygame.draw.line(screen, KRILL_BODY, (lx, cy + 8),
                             (lx - 4, cy + 16), 2)
        pygame.draw.circle(screen, KRILL_BODY, (cx - 12, cy), 4)
        pygame.draw.circle(screen, KRILL_BODY, (cx + 12, cy), 4)
        pygame.draw.circle(screen, KRILL_EYE, (cx - 3, cy - 4), 2)
        pygame.draw.circle(screen, KRILL_EYE, (cx + 3, cy - 4), 2)

def draw_boss(screen, x, y, hp, max_hp, cn, font):
    """大冥龙 Boss：巨型黑龙 + 翅膀 + 红眼，头顶显示血条"""
    cx, cy = int(x), int(y)
    pygame.draw.polygon(screen, (15, 10, 25),
                        [(cx, cy), (cx - 46, cy - 34), (cx - 22, cy)])
    pygame.draw.polygon(screen, (15, 10, 25),
                        [(cx, cy), (cx + 46, cy - 34), (cx + 22, cy)])
    pygame.draw.ellipse(screen, KRILL_BODY, (cx - 34, cy - 20, 68, 40))
    for k in range(3):
        pygame.draw.arc(screen, (50, 40, 70),
                        (cx - 34 + k * 18, cy - 20, 24, 40), 0, math.pi, 2)
    pygame.draw.circle(screen, KRILL_EYE, (cx + 20, cy - 7), 6)
    pygame.draw.circle(screen, KRILL_EYE, (cx + 20, cy + 7), 6)
    pygame.draw.circle(screen, (255, 120, 120), (cx + 22, cy - 8), 2)
    pygame.draw.circle(screen, (255, 120, 120), (cx + 22, cy + 6), 2)
    # ---- Boss 血条（头顶） ----
    bar_w, bar_h = 80, 8
    bx, by = cx - bar_w // 2, cy - 42
    pygame.draw.rect(screen, (60, 50, 70), (bx, by, bar_w, bar_h))
    ratio = max(0, hp / max_hp)
    color = (255, 80, 80) if ratio < 0.3 else (255, 170, 60) if ratio < 0.6 \
        else (120, 220, 120)
    pygame.draw.rect(screen, color, (bx, by, int(bar_w * ratio), bar_h))
    pygame.draw.rect(screen, WHITE, (bx, by, bar_w, bar_h), 1)
    label = font.render(("大冥龙" if cn else "BOSS") + f" {hp}/{max_hp}",
                        True, (120, 40, 40))
    screen.blit(label, (cx - label.get_width() // 2, by - 18))

def draw_bullet(screen, x, y):
    pygame.draw.circle(screen, (255, 245, 180), (int(x), int(y)), 7)
    pygame.draw.circle(screen, LIGHT_WAVE, (int(x), int(y)), 4)

def draw_lives(screen, lives, x, y):
    """左上角画小爱心表示命数"""
    for i in range(lives):
        cx, cy = x + i * 22, y
        pygame.draw.circle(screen, (255, 100, 130), (cx - 4, cy - 2), 5)
        pygame.draw.circle(screen, (255, 100, 130), (cx + 4, cy - 2), 5)
        pygame.draw.polygon(screen, (255, 100, 130),
                            [(cx - 9, cy), (cx + 9, cy), (cx, cy + 10)])

# ----------------------------- 主游戏 ------------------------------------------
def run_game():
    pygame.init()
    screen = pygame.display.set_mode((WIDTH, HEIGHT))
    pygame.display.set_caption("光之子 vs 冥龙 —— WJL 的云端守护战（三关版）")
    clock = pygame.time.Clock()
    cn = has_cn_font()
    font_big = load_font(44)
    font_mid = load_font(28)
    font_small = load_font(20)

    T = {
        "win":   "星光汇聚，云野重归光明！" if cn else "LIGHT RESTORED!",
        "lose":  "翼之光熄灭了……" if cn else "Your light has faded...",
        "base":  "祭坛陷落，星光消逝……" if cn else "The altar has fallen...",
        "hint":  ("WASD/方向键移动 | 空格/J发射 | R重开 | ESC退出" if cn
                  else "WASD/Arrows | Space/J shoot | R restart | ESC quit"),
        "clear": "关卡通关！" if cn else "LEVEL CLEAR!",
        "next":  "即将进入下一关……" if cn else "Next level...",
        "final": "最终决战：击败大冥龙！" if cn else "FINAL: Defeat the Great Krill!",
        "level": "第 {} 关" if cn else "LEVEL {}",
    }

    SPAWN = (3.5 * TILE, 17.5 * TILE)     # 玩家出生点

    # ----------------- 状态初始化 -----------------
    def new_game():
        return {"level": 1, "lives": 3}

    def start_level(game):
        """根据关卡数生成该关的完整状态"""
        walls, base_rect = build_map()
        lvl = game["level"]
        st = {
            "walls": walls, "base": base_rect, "base_alive": True,
            "player": [SPAWN[0], SPAWN[1]], "pdir": (0, -1),
            "invincible": 0,
            "enemies": [], "boss": None, "bullets": [],
            "crab_timer": 0,
            "flash_timer": 0, "shake": 0,
            "state": "playing",
            "state_timer": 0, "lose_reason": "",
        }
        if lvl == 1:      # 第1关：3 只慢速追踪敌人
            spots = [(1.5, 1.5), (10, 1.5), (18, 1.5)]
            for i, (ex, ey) in enumerate(spots):
                st["enemies"].append(make_enemy(ex * TILE, ey * TILE,
                                                i % 2 == 0, speed=1.0,
                                                fire_rng=(140, 260)))
        elif lvl == 2:    # 第2关：5 只快速追踪敌人
            spots = [(1.5, 1.5), (10, 1.5), (18, 1.5), (4.5, 2.5), (15, 2.5)]
            for i, (ex, ey) in enumerate(spots):
                st["enemies"].append(make_enemy(ex * TILE, ey * TILE,
                                                i % 2 == 0, speed=1.6,
                                                fire_rng=(80, 180)))
        else:             # 第3关：大冥龙 Boss + 追踪螃蟹
            st["boss"] = {
                "x": 10 * TILE, "y": 2.5 * TILE,
                "hp": random.randint(10, 20),     # 随机 10~20 次打击死亡
                "max_hp": 0, "dir": random.choice([(1, 0), (-1, 0)]),
                "speed": 1.2, "turn": 0,
                "attack_timer": 150,
                "mode": 0,
            }
            st["boss"]["max_hp"] = st["boss"]["hp"]
            st["crab_timer"] = 180
        return st

    def make_enemy(x, y, is_krill, speed, fire_rng, chase=True):
        """生成敌人：全部追踪光之子；path/path_timer 用于 BFS 寻路"""
        return {"x": x, "y": y,
                "dir": random.choice([(1, 0), (-1, 0), (0, 1), (0, -1)]),
                "kind": "krill" if is_krill else "crab",
                "speed": speed,
                "wander_turn": random.randint(30, 90),   # 无敌期游走计时
                "fire": random.randint(*fire_rng), "fire_rng": fire_rng,
                "chase": chase,
                "path": [], "path_timer": random.randint(0, 30),
                "jitter": {}}            # 每格随机代价，让每个敌人路线不同

    game = new_game()
    S = start_level(game)

    # ----------------- 工具函数 -----------------
    def blocked(x, y, radius):
        r = pygame.Rect(x - radius, y - radius, radius * 2, radius * 2)
        for w, _ in S["walls"]:
            if r.colliderect(w):
                return True
        if S["base_alive"] and r.colliderect(S["base"]):
            return True
        return x < radius or x > WIDTH - radius or \
               y < radius or y > HEIGHT - radius

    def move_unit(unit, dx, dy, speed, radius):
        """分轴移动 + 返回是否被挡（用于换方向，防止卡住）"""
        hit = False
        nx = unit["x"] + dx * speed
        if not blocked(nx, unit["y"], radius):
            unit["x"] = nx
        else:
            hit = True
        ny = unit["y"] + dy * speed
        if not blocked(unit["x"], ny, radius):
            unit["y"] = ny
        else:
            hit = True
        return hit

    # ---------- BFS 寻路：绕过墙找到通往光之子的下一步 ----------
    def walkable_grid():
        """把地图转成 20x20 可走格子表（墙和祭坛不可走）"""
        grid = [[True] * COLS for _ in range(ROWS)]
        for w, _ in S["walls"]:
            grid[w.y // TILE][w.x // TILE] = False
        if S["base_alive"]:
            for r in range(S["base"].y // TILE, S["base"].bottom // TILE):
                for c in range(S["base"].x // TILE, S["base"].right // TILE):
                    if 0 <= r < ROWS and 0 <= c < COLS:
                        grid[r][c] = False
        return grid

    def find_path(e, tx, ty):
        """
        BFS 寻路 + 每格随机代价（jitter）：
        每个敌人的 jitter 不同，所以即使起点相同，
        不同敌人绕墙的路线也不一样（有的先左绕，有的先右绕）。
        返回下一步方向 (dx, dy)；找不到路返回 None。
        """
        grid = walkable_grid()
        sc, sr = int(e["x"] // TILE), int(e["y"] // TILE)
        tc, tr = int(tx // TILE), int(ty // TILE)
        if not (0 <= sc < COLS and 0 <= sr < ROWS):
            return None
        # 玩家所在格不可走（贴着祭坛）时，退化为直线方向
        if not (0 <= tc < COLS and 0 <= tr < ROWS) or not grid[tr][tc]:
            return (1 if tx > e["x"] else -1, 0) if abs(tx - e["x"]) > \
                abs(ty - e["y"]) else (0, 1 if ty > e["y"] else -1)
        # 随机更新本敌人的“路径偏好”
        if not e["jitter"] or random.random() < 0.02:
            e["jitter"] = {(r, c): random.random()
                           for r in range(ROWS) for c in range(COLS)}
        dist = {(sr, sc): 0}
        prev = {(sr, sc): None}
        dq = deque([(sr, sc)])
        while dq:
            r, c = dq.popleft()
            if (r, c) == (tr, tc):
                break
            for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
                nr, nc = r + dr, c + dc
                if 0 <= nr < ROWS and 0 <= nc < COLS and grid[nr][nc] \
                        and (nr, nc) not in dist:
                    # 代价 = 上一步 + 1 + 随机抖动 -> 同距离下偏好随机
                    dist[(nr, nc)] = dist[(r, c)] + 1 + e["jitter"][(nr, nc)]
                    prev[(nr, nc)] = (r, c)
                    dq.append((nr, nc))
        if (tr, tc) not in prev:
            return None
        # 回溯到第一步
        cur = (tr, tc)
        while prev[cur] and prev[cur] != (sr, sc):
            cur = prev[cur]
        if prev[cur] is None:
            return None
        return (cur[1] - sc, cur[0] - sr)

    def fire(x, y, dx, dy, owner, speed=6):
        S["bullets"].append([x + dx * 16, y + dy * 16, dx, dy, owner, speed])

    def hurt_player(reason):
        """光之子受击：扣 1 条命；命用完了才真正游戏结束"""
        if S["invincible"] > 0 or S["state"] != "playing":
            return
        game["lives"] -= 1
        S["flash_timer"] = 45
        S["shake"] = 20
        if game["lives"] <= 0:
            S["state"] = "over"
            S["lose_reason"] = reason
        else:
            # 还有命：回出生点复活，附带 1 秒无敌
            S["player"] = [SPAWN[0], SPAWN[1]]
            S["invincible"] = 60   # 1 秒无敌

    def add_life_reward():
        """过关奖励：随机 +1~5 条命，可叠加"""
        bonus = random.randint(1, 5)
        game["lives"] += bonus
        return bonus

    # =========================== 主循环 =====================================
    while True:
        clock.tick(FPS)

        # ---- 事件处理 ----
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit(); sys.exit()
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    pygame.quit(); sys.exit()
                # ★ R 键：分出胜负后随时可重开
                if event.key == pygame.K_r and S["state"] in ("over", "win"):
                    game = new_game()
                    S = start_level(game)
                # ★ 无敌期无法开火
                if event.key in (pygame.K_SPACE, pygame.K_j) \
                        and S["state"] == "playing" and S["invincible"] <= 0:
                    fire(S["player"][0], S["player"][1],
                         S["pdir"][0], S["pdir"][1], "p")

        keys = pygame.key.get_pressed()

        # ---- 玩家移动（WASD + 方向键 都支持） ----
        if S["state"] == "playing":
            move = None
            if keys[pygame.K_UP] or keys[pygame.K_w]:       move = (0, -1)
            elif keys[pygame.K_DOWN] or keys[pygame.K_s]:   move = (0, 1)
            elif keys[pygame.K_LEFT] or keys[pygame.K_a]:   move = (-1, 0)
            elif keys[pygame.K_RIGHT] or keys[pygame.K_d]:  move = (1, 0)
            if move:
                S["pdir"] = move
                p = {"x": S["player"][0], "y": S["player"][1]}
                move_unit(p, move[0], move[1], 2.6, 12)
                S["player"] = [p["x"], p["y"]]
            if S["invincible"] > 0:
                S["invincible"] -= 1

        # ---- 敌人 AI：BFS 寻路追踪光之子（每个敌人路线不同） ----
        if S["state"] == "playing":
            px, py = S["player"]
            for e in S["enemies"][:]:
                if S["invincible"] > 0:
                    # ★ 复活无敌期：敌人失去锁定，原地随机游走，不开火
                    e["wander_turn"] -= 1
                    if e["wander_turn"] <= 0:
                        e["dir"] = random.choice(
                            [(1, 0), (-1, 0), (0, 1), (0, -1)])
                        e["wander_turn"] = random.randint(30, 90)
                    d = e["dir"]
                    if move_unit(e, d[0], d[1], e["speed"], 13):
                        e["dir"] = random.choice(
                            [(1, 0), (-1, 0), (0, 1), (0, -1)])
                    e["path"] = []          # 清空旧路径
                    continue
                # ★ 每 0.5 秒重新寻路一次，绕过墙追踪光之子
                e["path_timer"] -= 1
                if e["path_timer"] <= 0 or not e["path"]:
                    step = find_path(e, px, py)
                    if step:
                        e["dir"] = step
                        e["path"] = [step]
                    e["path_timer"] = 30
                d = e["dir"]
                # 撞墙则立即重新寻路（防止卡住）
                if move_unit(e, d[0], d[1], e["speed"], 13):
                    e["path_timer"] = 0
                # 开火：朝光之子所在的大致方向射
                e["fire"] -= 1
                if e["fire"] <= 0:
                    if abs(px - e["x"]) > abs(py - e["y"]):
                        d = (1 if px > e["x"] else -1, 0)
                    else:
                        d = (0, 1 if py > e["y"] else -1)
                    fire(e["x"], e["y"], d[0], d[1], "e", speed=4)
                    e["fire"] = random.randint(*e["fire_rng"])
                # 碰到光之子
                if abs(e["x"] - px) < 22 and abs(e["y"] - py) < 22:
                    hurt_player("hit")

        # ---- 第3关：Boss 大冥龙 AI ----
        if S["state"] == "playing" and S["boss"] and S["boss"]["hp"] > 0:
            b = S["boss"]
            px, py = S["player"]
            # ★ Boss 在空中飞行，无视一切墙体，直接朝光之子漂移 ★
            ddx = 0.4 if px > b["x"] else -0.4
            ddy = 0.4 if py > b["y"] else -0.4
            b["x"] = max(40, min(WIDTH - 40, b["x"] + ddx))
            b["y"] = max(50, min(HEIGHT - 40, b["y"] + ddy))
            # 碰到光之子
            if abs(b["x"] - px) < 40 and abs(b["y"] - py) < 40:
                hurt_player("hit")
            # ★ Boss 三种攻击方式，循环轮换；无敌期不攻击 ★
            if S["invincible"] > 0:
                b["attack_timer"] = max(b["attack_timer"], 30)
            else:
                b["attack_timer"] -= 1
            if S["invincible"] <= 0 and b["attack_timer"] <= 0:
                ang_to_p = math.atan2(py - b["y"], px - b["x"])
                if b["mode"] == 0:
                    # 攻击一：向四周环形散射 12 枚黑暗弹
                    for k in range(12):
                        a = k * math.pi / 6
                        fire(b["x"], b["y"], math.cos(a), math.sin(a),
                             "e", speed=3.5)
                elif b["mode"] == 1:
                    # 攻击二：瞄准光之子的扇形 5 连发
                    for k in range(-2, 3):
                        a = ang_to_p + k * 0.18
                        fire(b["x"], b["y"], math.cos(a), math.sin(a),
                             "e", speed=4.5)
                else:
                    # 攻击三：追踪直射 3 连发（速度错开形成先后命中）
                    for k in range(3):
                        fire(b["x"], b["y"], math.cos(ang_to_p),
                             math.sin(ang_to_p), "e", speed=3 + k)
                b["mode"] = (b["mode"] + 1) % 3
                b["attack_timer"] = random.randint(140, 220)

        # ---- 第3关：持续刷新追踪螃蟹 ----
        if S["state"] == "playing" and game["level"] == 3:
            S["crab_timer"] -= 1
            crabs = [e for e in S["enemies"] if e["chase"]]
            if S["crab_timer"] <= 0 and len(crabs) < 4:
                cx = random.choice([2, 6, 10, 14, 18]) * TILE
                S["enemies"].append(make_enemy(cx, 1.5 * TILE, False,
                                               speed=1.8,
                                               fire_rng=(150, 300),
                                               chase=True))
                S["crab_timer"] = random.randint(240, 420)  # 4~7 秒一只

        # ---- 子弹运动与碰撞 ----
        new_bullets = []
        for bl in S["bullets"]:
            bl[0] += bl[2] * bl[5]
            bl[1] += bl[3] * bl[5]
            hit = False
            br = pygame.Rect(bl[0] - 4, bl[1] - 4, 8, 8)
            if bl[0] < 0 or bl[0] > WIDTH or bl[1] < 0 or bl[1] > HEIGHT:
                hit = True
            if not hit:
                for w, kind in S["walls"][:]:
                    if br.colliderect(w):
                        hit = True
                        if kind == "cloud":
                            S["walls"].remove((w, kind))
                        break
            if not hit and S["base_alive"] and br.colliderect(S["base"]):
                S["base_alive"] = False
                S["state"] = "over"
                S["lose_reason"] = "base"
                S["flash_timer"] = 45
                hit = True
            # 玩家光波命中
            if not hit and bl[4] == "p":
                for e in S["enemies"][:]:
                    if abs(e["x"] - bl[0]) < 16 and abs(e["y"] - bl[1]) < 16:
                        S["enemies"].remove(e)
                        hit = True
                        break
                # 打 Boss：20% 概率暴击（一次算 2 下）
                if not hit and S["boss"] and S["boss"]["hp"] > 0 \
                        and abs(S["boss"]["x"] - bl[0]) < 38 \
                        and abs(S["boss"]["y"] - bl[1]) < 28:
                    dmg = 2 if random.random() < 0.2 else 1
                    S["boss"]["hp"] -= dmg
                    S["shake"] = 8
                    hit = True
                    if S["boss"]["hp"] <= 0:
                        S["flash_timer"] = 60
            # 敌方子弹打玩家
            if not hit and bl[4] == "e" and S["state"] == "playing" \
                    and S["invincible"] <= 0:
                if abs(S["player"][0] - bl[0]) < 14 and \
                        abs(S["player"][1] - bl[1]) < 14:
                    hurt_player("hit")
                    hit = True
            if not hit:
                new_bullets.append(bl)
        S["bullets"] = new_bullets

        # ---- 过关判定 ----
        if S["state"] == "playing":
            boss_dead = (S["boss"] is None or S["boss"]["hp"] <= 0)
            if game["level"] < 3:
                if not S["enemies"]:
                    bonus = add_life_reward()
                    S["state"] = "levelclear"
                    S["state_timer"] = 150
                    S["bonus"] = bonus
            else:
                if boss_dead:
                    S["state"] = "win"
                    S["flash_timer"] = 60

        # 过关倒计时 -> 进入下一关
        if S["state"] == "levelclear":
            S["state_timer"] -= 1
            if S["state_timer"] <= 0:
                game["level"] += 1
                S = start_level(game)

        # =========================== 绘制 ===========================
        draw_sky(screen)
        for w, kind in S["walls"]:
            draw_wall(screen, w, kind)
        draw_base(screen, S["base"], not S["base_alive"])
        for e in S["enemies"]:
            draw_enemy(screen, e["x"], e["y"], e["kind"])
        if S["boss"] and S["boss"]["hp"] > 0:
            draw_boss(screen, S["boss"]["x"], S["boss"]["y"],
                      S["boss"]["hp"], S["boss"]["max_hp"], cn, font_small)
        draw_player(screen, S["player"][0], S["player"][1],
                    S["pdir"], S["invincible"])
        for bl in S["bullets"]:
            if bl[4] == "p":
                draw_bullet(screen, bl[0], bl[1])
            else:
                pygame.draw.circle(screen, (90, 40, 120),
                                   (int(bl[0]), int(bl[1])), 5)

        # ---- 受击/死亡闪烁特效 + 屏幕震动 ----
        if S["flash_timer"] > 0:
            S["flash_timer"] -= 1
            if (S["flash_timer"] // 6) % 2 == 0:
                flash = pygame.Surface((WIDTH, HEIGHT))
                flash.set_alpha(120)
                flash.fill(WHITE if S["flash_timer"] > 20 else (20, 15, 30))
                screen.blit(flash, (0, 0))
        if S["shake"] > 0:
            S["shake"] -= 1
            screen.scroll(random.randint(-3, 3), random.randint(-3, 3))

        # ---- HUD ----
        info = font_small.render(T["hint"], True, (90, 100, 130))
        screen.blit(info, (10, HEIGHT - 24))
        lvl_txt = font_small.render(
            T["level"].format(game["level"]) + "  |  WJL", True, (90, 100, 130))
        screen.blit(lvl_txt, (10, 4))
        draw_lives(screen, game["lives"], 24, 44)
        if game["level"] == 3:
            warn = font_small.render(T["final"], True, (180, 60, 60))
            screen.blit(warn, (WIDTH - warn.get_width() - 10, 4))

        # ---- 结算 / 过场 ----
        if S["state"] in ("over", "win", "levelclear"):
            overlay = pygame.Surface((WIDTH, HEIGHT))
            overlay.set_alpha(170)
            if S["state"] == "win":
                overlay.fill((255, 250, 235))
            elif S["state"] == "levelclear":
                overlay.fill((230, 245, 255))
            else:
                overlay.fill((25, 20, 35))
            screen.blit(overlay, (0, 0))
            if S["state"] == "win":
                msg = font_big.render(T["win"], True, (200, 150, 30))
            elif S["state"] == "levelclear":
                msg = font_big.render(T["clear"], True, (80, 140, 200))
                bonus_txt = font_mid.render(
                    ("星光祝福：生命 +{}！".format(S["bonus"]) if cn
                     else f"Blessing: +{S['bonus']} HP!"), True, (200, 120, 60))
                screen.blit(bonus_txt, bonus_txt.get_rect(
                    center=(WIDTH / 2, HEIGHT / 2 + 50)))
                nxt = font_mid.render(T["next"], True, (120, 130, 160))
                screen.blit(nxt, nxt.get_rect(center=(WIDTH / 2,
                                                      HEIGHT / 2 + 90)))
            else:
                reason = T["base"] if S["lose_reason"] == "base" else T["lose"]
                msg = font_big.render(reason, True, (255, 200, 120))
            screen.blit(msg, msg.get_rect(center=(WIDTH / 2, HEIGHT / 2)))
            if S["state"] in ("over", "win"):
                tip = font_mid.render(
                    "按 R 重新开始" if cn else "Press R to restart",
                    True, (150, 150, 170))
                screen.blit(tip, tip.get_rect(center=(WIDTH / 2,
                                                      HEIGHT / 2 + 60)))

        pygame.display.flip()

if __name__ == "__main__":
    run_game()
